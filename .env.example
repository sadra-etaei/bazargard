# Local development defaults. Copy to .env and keep .env out of Git.
DJANGO_SECRET_KEY=replace-with-a-long-random-value-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional assistant endpoint. Empty values enable the rule-based fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# Dataset phone numbers are synthetic. These modes deliver nothing.
SMS_PROVIDER=simulated
VOICE_PROVIDER=simulated
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
SMS_TEST_RECEPTOR=
PUBLIC_BASE_URL=
INQUIRY_TTL_HOURS=48
INQUIRIES_PER_DEVICE_PER_DAY=20

# Optional paths: APP_DB, CATALOG_DB, DATA_DIR, DATASET_DIR, FRONTEND_DIST
# Production: DEBUG=0, strong SECRET_KEY, explicit hosts/origins, HTTPS.
